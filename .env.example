# Your amateur radio callsign. Used to identify this client to APRS-IS.
APRS_CALLSIGN=N0CALL

# -1 is the read-only passcode. Leave it at -1.
# This app never transmits; a real passcode is neither needed nor wanted here.
APRS_PASSCODE=-1

APRS_HOST=rotate.aprs2.net
APRS_PORT=14580

DB_PATH=data/courseops.sqlite3
LOG_LEVEL=INFO
